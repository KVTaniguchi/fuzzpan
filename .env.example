# Copy to .env and edit. .env is git-ignored. Placeholders only; no secrets live here.

# Your domain, pointing at this machine (ports 80 and 443 open). Caddy fetches a
# certificate for it automatically. Leave unset to try the board at https://localhost.
BOARD_DOMAIN=board.example.com

# The address people type, no trailing slash. Setup and invite links are built from it.
# Defaults to https://BOARD_DOMAIN. If you change BOARD_HTTPS_PORT, set this with the port
# (e.g. https://board.example.com:8443) or the links it prints will not work.
BOARD_PUBLIC_URL=https://board.example.com

# Optional: publish Caddy on other host ports (defaults 80 and 443).
#BOARD_HTTP_PORT=80
#BOARD_HTTPS_PORT=443

# Backups to your own computer need no settings here: scripts/backup_pull.sh runs on that
# computer and reads BOARD_SSH, BOARD_REMOTE_DIR, BACKUP_DIR, BACKUP_KEEP and AGE_RECIPIENT
# from its environment (see README).
# Backups (scripts/backup_offsite.sh reads this file itself; real environment variables win): an age public key (starts "age1...") and an
# rclone destination such as "myremote:board-backups".
AGE_RECIPIENT=age1replace-with-your-public-key
RCLONE_REMOTE=myremote:board-backups

# Development only, outside Docker: BOARD_SECURE_COOKIES=0 allows plain-HTTP logins.
# Never set it on a board anyone else can reach.
